<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only the system certificate store (user-installed CAs are not trusted),
     so the schedule download can't be read or altered on the network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
